# En-têtes HTTP pour Cloudflare Pages (copié tel quel dans dist/ au build).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'

# Fichiers du build nommés par empreinte (index-XXXX.js…) : ils ne changent jamais, cache d'un an.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sons et image d'origine : stables, cache d'une semaine.
/sounds/*
  Cache-Control: public, max-age=604800
/img/*
  Cache-Control: public, max-age=604800

# Données (table des sons, thèmes fixes) : peuvent évoluer, cache d'une heure.
/data/*
  Cache-Control: public, max-age=3600
